[Unit]
Description=VayaVia Agent API Service
After=network.target postgresql.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/vayavia-agent
ExecStart=/usr/bin/python3 -m uvicorn agent.api_service:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=3
EnvironmentFile=/opt/vayavia-agent/.env

[Install]
WantedBy=multi-user.target

# Install instructions:
# 1. cp /opt/vayavia-agent/systemd/vayavia-api.service /etc/systemd/system/
# 2. systemctl daemon-reload
# 3. systemctl enable vayavia-api
# 4. systemctl start vayavia-api
